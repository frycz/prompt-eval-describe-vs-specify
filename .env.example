# Copy to .env and fill in your key. .env is gitignored.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Default model for every call. Override per call with -m / model=.
# Leave unset to use the built-in default (claude-haiku-4-5).
ANTHROPIC_MODEL=claude-haiku-4-5
